{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/behavior/layout,_N_T_/behavior/checks/layout,_N_T_/behavior/checks/page,_N_T_/behavior/checks"
  },
  "segmentPaths": [
    "/_tree",
