@echo off
chcp 65001 > nul

:: ========================================
::  汽修管家 — 移动硬盘备份脚本
:: ========================================
:: 功能：把"上传的图片/视频"和"备份包"复制到移动硬盘
:: 用法：插上移动硬盘后，双击本脚本
:: 说明：只增加/更新文件，绝不删除移动硬盘上的任何文件
:: ========================================

setlocal

:: --- 配置区域（盘符变了就改这里） ---
set "移动硬盘=F:"
set "上传文件源=E:\autorepair-uploads"
set "备份包源=E:\backup\auto-repair-shop"
set "备份目标根=%移动硬盘%\汽修系统备份"
:: -----------------------------------

echo ========================================
echo  汽修管家 — 移动硬盘备份
echo ========================================
echo.

:: 检查移动硬盘是否插好
if not exist "%移动硬盘%\" (
    echo [错误] 找不到移动硬盘 %移动硬盘%
    echo 请确认移动硬盘已插好，盘符是 %移动硬盘%
    echo 如果盘符变了，用记事本打开本脚本，改第一行的盘符设置
    echo.
    pause
    exit /b 1
)

echo 移动硬盘：%移动硬盘%
echo 备份到：%备份目标根%
echo.

:: 第 1 步：复制上传的图片/视频（46GB 首次较慢，以后只拷新增文件）
echo [1/2] 正在备份上传的图片/视频...
echo       （首次备份文件较多，请耐心等待，不要关窗口）
robocopy "%上传文件源%" "%备份目标根%\上传文件" /E /R:1 /W:2 /NFL /NDL /NP
if errorlevel 8 (
    echo [错误] 上传文件备份失败，请检查硬盘空间
    pause
    exit /b 1
)
echo       上传文件备份完成
echo.

:: 第 2 步：复制备份包（代码+数据库的 zip）
echo [2/2] 正在备份备份包...
robocopy "%备份包源%" "%备份目标根%\备份包" /E /R:1 /W:2 /NFL /NDL /NP
if errorlevel 8 (
    echo [错误] 备份包复制失败
    pause
    exit /b 1
)
echo       备份包复制完成
echo.

echo ========================================
echo  全部备份完成！
echo  移动硬盘上的位置：%备份目标根%
echo  现在可以安全拔出移动硬盘了
echo ========================================
echo.
pause
