<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- ====== 状态1：相机预览 ====== -->
    <FrameLayout
        android:id="@+id/cameraContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- 相机预览 -->
        <androidx.camera.view.PreviewView
            android:id="@+id/previewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- 车牌取景框：横向矩形 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:paddingHorizontal="32dp"
            android:paddingVertical="180dp"
            android:clipChildren="false">

            <!-- 外框 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/plate_frame" />

            <!-- 左上角 -->
            <View
                android:layout_width="24dp"
                android:layout_height="3dp"
                android:layout_gravity="top|start"
                android:layout_marginTop="-1dp"
                android:layout_marginStart="-1dp"
                android:background="@color/barcode_scan_green" />
            <View
                android:layout_width="3dp"
                android:layout_height="24dp"
                android:layout_gravity="top|start"
                android:layout_marginTop="-1dp"
                android:layout_marginStart="-1dp"
                android:background="@color/barcode_scan_green" />

            <!-- 右上角 -->
            <View
                android:layout_width="24dp"
                android:layout_height="3dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="-1dp"
                android:layout_marginEnd="-1dp"
                android:background="@color/barcode_scan_green" />
            <View
                android:layout_width="3dp"
                android:layout_height="24dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="-1dp"
                android:layout_marginEnd="-1dp"
                android:background="@color/barcode_scan_green" />

            <!-- 左下角 -->
            <View
                android:layout_width="24dp"
                android:layout_height="3dp"
                android:layout_gravity="bottom|start"
                android:layout_marginBottom="-1dp"
                android:layout_marginStart="-1dp"
                android:background="@color/barcode_scan_green" />
            <View
                android:layout_width="3dp"
                android:layout_height="24dp"
                android:layout_gravity="bottom|start"
                android:layout_marginBottom="-1dp"
                android:layout_marginStart="-1dp"
                android:background="@color/barcode_scan_green" />

            <!-- 右下角 -->
            <View
                android:layout_width="24dp"
                android:layout_height="3dp"
                android:layout_gravity="bottom|end"
                android:layout_marginBottom="-1dp"
                android:layout_marginEnd="-1dp"
                android:background="@color/barcode_scan_green" />
            <View
                android:layout_width="3dp"
                android:layout_height="24dp"
                android:layout_gravity="bottom|end"
                android:layout_marginBottom="-1dp"
                android:layout_marginEnd="-1dp"
                android:background="@color/barcode_scan_green" />
        </FrameLayout>

        <!-- 顶部栏：关闭按钮 + 标题 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:background="@color/barcode_scan_control_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="拍照识别车牌"
                android:textColor="@color/barcode_scan_white"
                android:textSize="16sp" />

            <ImageButton
                android:id="@+id/closeButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="关闭"
                android:padding="8dp"
                android:src="@drawable/ic_close" />
        </LinearLayout>

        <!-- 提示文字 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center|bottom"
            android:layout_marginBottom="120dp"
            android:background="@drawable/bg_scan_hint"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:text="将车牌对准框内，点击按钮拍照"
            android:textColor="@color/barcode_scan_white"
            android:textSize="12sp" />

        <!-- 底部拍照按钮 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@color/barcode_scan_control_bg"
            android:paddingVertical="24dp">

            <ImageButton
                android:id="@+id/shutterButton"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_gravity="center"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="拍照"
                android:padding="4dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_shutter" />
        </FrameLayout>
    </FrameLayout>

    <!-- ====== 状态2：拍照结果 ====== -->
    <FrameLayout
        android:id="@+id/resultContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <!-- 预览图 -->
        <ImageView
            android:id="@+id/resultImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:background="@android:color/black" />

        <!-- 结果遮罩 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@color/barcode_scan_control_bg"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 识别中 loading -->
            <ProgressBar
                android:id="@+id/recognizingProgress"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginBottom="8dp"
                android:indeterminateTint="@color/barcode_scan_white" />

            <!-- 识别结果 -->
            <TextView
                android:id="@+id/resultText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:textColor="@color/barcode_scan_green"
                android:textSize="20sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- 错误信息 -->
            <TextView
                android:id="@+id/errorText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:textColor="#FF6B6B"
                android:textSize="14sp"
                android:visibility="gone" />

            <!-- 按钮区 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/retakeButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"
                    android:backgroundTint="#444444"
                    android:text="重拍"
                    android:textColor="@color/barcode_scan_white" />

                <Button
                    android:id="@+id/confirmButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#4ADE80"
                    android:text="确认使用"
                    android:textColor="#000000"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
